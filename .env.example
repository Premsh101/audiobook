# Self-hosted PostgreSQL on the KVM
DATABASE_URL=postgresql://hush:change-me@127.0.0.1:5433/hush

# Optional application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Later: object storage / payments / TTS provider secrets
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# ELEVENLABS_API_KEY=

VOICE_UPLOAD_DIR=.data/voices
TTS_PROVIDER=pending
TTS_MODEL=
TTS_SERVICE_URL=http://tts-service:8000/synthesize
VOICE_OUTPUT_DIR=/data/hush/voice-output
TTS_PREVIEW_MAX_CHARACTERS=6000
TTS_WORKER_POLL_MS=5000
